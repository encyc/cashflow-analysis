# collector 服务配置模板：复制为 .env 后填写。SMTP_HOST 留空 = dry-run 模式（不联网，邮件写入 outbox/ 的 .eml）

PORT=8000
INBOX_DIR=inbox
OUTBOX_DIR=outbox
MAX_UPLOAD_MB=100
MAIL_ATTACH_LIMIT_MB=45

# ---- SMTP 发信配置（以 QQ 邮箱为例：host=smtp.qq.com，port=465，SSL=true，PASS 填授权码而非登录密码）----
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# 每 IP 限流：时间窗口内最多提交次数，设 0 关闭
RATE_LIMIT_PER_IP=5
RATE_LIMIT_WINDOW_MIN=10
